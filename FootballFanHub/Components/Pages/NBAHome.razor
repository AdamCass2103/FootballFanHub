@page "/nba"
@rendermode InteractiveServer
@inject IBalldontlieService BalldontlieService
@inject INbaFavouritesRepository NbaFavourites

<h3>NBA Centre</h3>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <a class="card h-100 text-decoration-none text-reset" href="/nba/search">
            <div class="card-body">
                <h5>Search NBA teams</h5>
                <p class="text-muted mb-0">Find any NBA team and view its details.</p>
            </div>
        </a>
    </div>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (isLoading)
{
    <div class="loading-box">Loading NBA teams…</div>
}
else
{
    <h5>NBA teams</h5>
    <div class="row">
        @foreach (var team in displayTeams)
        {
            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <a class="text-decoration-none text-reset flex-grow-1" href="/nba/team/@team.Id">
                            <img src="@team.LogoUrl" alt="@team.Full_Name logo" style="height:64px" class="mb-2" />
                            <h6>@team.Full_Name</h6>
                            <small class="text-muted">@team.Abbreviation</small>
                        </a>
                        <button class="btn btn-sm mt-2 @(favouriteIds.Contains(team.Id) ? "btn-danger" : "btn-outline-primary")"
                                @onclick="() => ToggleFavouriteAsync(team)">
                            @(favouriteIds.Contains(team.Id) ? "★ Following" : "☆ Follow")
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    // Only the current 30 NBA franchises — the API also returns historical
    // and international teams which have no logo or player data.
    private static readonly HashSet<string> NbaTeamAbbreviations = new()
    {
        "ATL","BOS","BKN","CHA","CHI","CLE","DAL","DEN","DET","GSW",
        "HOU","IND","LAC","LAL","MEM","MIA","MIL","MIN","NOP","NYK",
        "OKC","ORL","PHI","PHX","POR","SAC","SAS","TOR","UTA","WAS"
    };

    private List<NBATeam> teams = new();
    private HashSet<int> favouriteIds = new();
    private bool isLoading = true;
    private string? errorMessage;

    // Favourites first, then alphabetical by full name
    private IEnumerable<NBATeam> displayTeams => teams
        .OrderByDescending(t => favouriteIds.Contains(t.Id))
        .ThenBy(t => t.Full_Name);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allTeams = await BalldontlieService.GetTeamsAsync();
            teams = allTeams
                .Where(t => NbaTeamAbbreviations.Contains(t.Abbreviation))
                .ToList();

            var favs = await NbaFavourites.GetAllAsync();
            favouriteIds = favs.Select(f => f.Id).ToHashSet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load NBA teams: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleFavouriteAsync(NBATeam team)
    {
        if (favouriteIds.Contains(team.Id))
        {
            await NbaFavourites.RemoveAsync(team.Id);
            favouriteIds.Remove(team.Id);
        }
        else
        {
            await NbaFavourites.AddAsync(team);
            favouriteIds.Add(team.Id);
        }
    }
}