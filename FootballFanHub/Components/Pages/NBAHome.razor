@page "/nba"
@rendermode InteractiveServer
@inject IBalldontlieService BalldontlieService

<h3>NBA Centre</h3>

<div class="row mb-4">
    <div class="col-md-4 mb-3">
        <a class="card h-100 text-decoration-none text-reset" href="/nba/search">
            <div class="card-body">
                <h5>Search NBA teams</h5>
                <p class="text-muted mb-0">Find any NBA team and view its details.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4 mb-3">
        <a class="card h-100 text-decoration-none text-reset" href="/nba/standings">
            <div class="card-body">
                <h5>NBA standings</h5>
                <p class="text-muted mb-0">View the Eastern and Western Conference standings.</p>
            </div>
        </a>
    </div>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (isLoading)
{
    <div class="loading-box">Loading NBA teams…</div>
}
else
{
    <h5>NBA teams</h5>
    <div class="row">
        @foreach (var team in teams)
        {
            <div class="col-md-4 col-lg-3 mb-3">
                <a class="card h-100 text-decoration-none text-reset" href="/nba/team/@team.Id">
                    <div class="card-body">
                        <img src="@team.LogoUrl" alt="@team.Full_Name logo" style="height:64px" class="mb-2" />
                        <h6>@team.Full_Name</h6>
                        <small class="text-muted">@team.Abbreviation</small>
                    </div>
                </a>
            </div>
        }
    </div>
}

@code {
    private List<NBATeam> teams = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            teams = await BalldontlieService.GetTeamsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load NBA teams: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
