@page "/nba/standings"
@rendermode InteractiveServer
@inject IBalldontlieService BalldontlieService

<h3>NBA Standings</h3>

<div class="d-flex gap-2 align-items-center mb-3">
    <label for="season">Season</label>
    <input id="season" class="form-control" style="max-width:110px" type="number"
           min="1946" max="@DateTime.UtcNow.Year" @bind="season" @bind:after="LoadAsync" />
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (isLoading)
{
    <div class="loading-box">Loading NBA standings…</div>
}
else if (standings.Count == 0)
{
    <p class="text-muted">No standings are available for the selected season.</p>
}
else
{
    <div class="row">
        @foreach (var conference in standings.GroupBy(x => x.Team.Conference).OrderBy(x => x.Key))
        {
            <div class="col-md-6 mb-4">
                <h5>@(string.IsNullOrWhiteSpace(conference.Key) ? "Conference" : conference.Key) Conference</h5>
                <table class="table standings-table">
                    <thead>
                        <tr><th>#</th><th>Team</th><th>W</th><th>L</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var standing in conference.OrderBy(x => x.Rank))
                        {
                            <tr>
                                <td>@standing.Rank</td>
                                <td>
                                    <a href="/nba/team/@standing.Team.Id" class="text-decoration-none text-reset">
                                        <img src="@standing.Team.LogoUrl" alt="" style="height:28px" class="me-2" />
                                        @standing.Team.Full_Name
                                    </a>
                                </td>
                                <td>@standing.Wins</td>
                                <td>@standing.Losses</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    private int season = DateTime.UtcNow.Year - 1;
    private List<NBAStanding> standings = new();
    private bool isLoading;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            standings = await BalldontlieService.GetStandingsAsync(season);
        }
        catch (Exception ex)
        {
            standings = new();
            errorMessage = $"Failed to load NBA standings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
